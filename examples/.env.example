# Copy to .env (or export these in your shell) if you want to override the
# baked-in development defaults.

LINK_PORT=8080
LINK_URL=ws://localhost:8080

# Per-peer HMAC keys. The hub holds all three; each peer holds only its own.
# Treat as you would database passwords - do NOT commit real values.
LINK_KEY_VAULT=dev-vault-key
LINK_KEY_WORKER=dev-worker-key
LINK_KEY_COORDINATOR=dev-coord-key