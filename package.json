{
  "name": "@presenc3/link-core",
  "version": "0.4.0",
  "description": "Shared WebSocket link protocol, client, and hub for inter-service communication",
  "main":   "./src/index.js",
  "module": "./src/index.mjs",
  "types":  "./src/index.d.ts",
  "exports": {
    ".": {
      "types":   "./src/index.d.ts",
      "import":  "./src/index.mjs",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "CHANGELOG.MD",
    "LICENSE",
    "package.json",
    "README.MD"
  ],
  "keywords": [
    "websocket",
    "ws",
    "rpc",
    "service-bus",
    "ipc",
    "hmac",
    "hub",
    "microservices",
    "protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Presenc3/link-core.git"
  },
  "author": "Presenc3",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Presenc3/link-core/issues"
  },
  "homepage": "https://github.com/Presenc3/link-core#readme",
  "dependencies": {
    "ws": "^8.20.0",
    "@types/ws": "^8.18.1"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}