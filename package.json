{
  "name": "@presenc3/link-core",
  "version": "0.5.0",
  "description": "Shared WebSocket link protocol, client, and hub for inter-service communication. Also bundles companion helpers (logger, env coercion, observability, RPC patterns, lifecycle, secrets loader)",
  "main":   "./src/index.js",
  "module": "./src/index.mjs",
  "types":  "./src/index.d.ts",
  "exports": {
    ".": {
      "types":   "./src/index.d.ts",
      "import":  "./src/index.mjs",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./helpers": {
      "types":   "./src/helpers/index.d.ts",
      "import":  "./src/helpers/index.mjs",
      "require": "./src/helpers/index.js",
      "default": "./src/helpers/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "keywords": [
    "websocket",
    "ws",
    "rpc",
    "service-bus",
    "ipc",
    "hmac",
    "hub",
    "microservices",
    "protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Presenc3/link-core.git"
  },
  "author": "Presenc3",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Presenc3/link-core/issues"
  },
  "homepage": "https://github.com/Presenc3/link-core#readme",
  "dependencies": {
    "ws": "^8.20.0"
  },
  "peerDependencies": {
    "@types/ws": "^8.18.1"
  },
  "peerDependenciesMeta": {
    "@types/ws": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test":            "node --test \"test/**/*.test.js\" \"test/**/*.test.mjs\"",
    "test:unit":       "node --test \"test/unit/**/*.test.js\" \"test/helpers/**/*.test.js\"",
    "test:integration":"node --test \"test/integration/**/*.test.js\"",
    "test:exports":    "node --test \"test/exports/**/*.test.js\" \"test/exports/**/*.test.mjs\"",
    "check:pack":      "npm pack --dry-run",
    "prepublishOnly":  "npm test && npm run check:pack"
  }
}